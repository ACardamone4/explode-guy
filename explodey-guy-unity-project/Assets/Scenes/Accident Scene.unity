    dialogueLines:
    - character:
        name: Expedition Leader
        icon: {fileID: 21300000, guid: 25418fddad067c5409456efc29522b4d, type: 3}
      line: Hello there! You must be our last crew member, right? I'll be your expedition
        leader! Is this your first mission?
    - character:
        name: Epic Name Here
        icon: {fileID: 277585542, guid: 98939d8069f48a849a9dc1de9596614c, type: 3}
      line: Uh, yeah... actually, what is my job, exactly...?
    - character:
        name: Expedition Leader
        icon: {fileID: 21300000, guid: 25418fddad067c5409456efc29522b4d, type: 3}
      line: Oh don't worry, it's super easy, you'll pick it up on the way! Here,
        let's get on the elevator, then we can talk!
