MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 183793314}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9c8b02fa0466d784f86ceeacb8c008f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Interviewer Again
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: Oh finally, you got through.
    - character:
        name: Interviewer Again
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: You new employees act like you've never been strapped to dynamite before.
    - character:
        name: Epic Name Here
        icon: {fileID: 277585542, guid: 98939d8069f48a849a9dc1de9596614c, type: 3}
      line: I haven't!!
    - character:
        name: Interviewer Again
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: ...Oh, who knew.
    - character:
        name: Interviewer Again
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: Anyways, congrats on making it through. Officially, welcome to MidaCorp
        (tm)!
    - character:
        name: Interviewer Again
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: Take the elevator on the left to get to Headquarters, there you'll get
        your first job.
  forceDialogue: 1
  repeat: 0
  ButtonPresses: 0
  DialogueLines: 6
  _swapCams: {fileID: 183793319}
  _cameraSwapper: 1
  _activateOnDeath: 0
  _activatedObject: {fileID: 0}
