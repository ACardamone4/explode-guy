  dialogue:
    dialogueLines:
    - character:
        name: Interviewer
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: Hey there, here for the job?
    - character:
        name: Epic Name Here
        icon: {fileID: 277585542, guid: 98939d8069f48a849a9dc1de9596614c, type: 3}
      line: Uh, yes!
    - character:
        name: Interviewer
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: Let me see...
    - character:
        name: Interviewer
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: Yellow guy, no defineable features...
    - character:
        name: Interviewer
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: Cool, you're hired. Just go down the hall and get started on the test
        course.
    - character:
        name: Interviewer
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: Best of luck, and welcome to MidaCorp.
  forceDialogue: 1
  repeat: 0
  ButtonPresses: 0
