--- !u!114 &271013927
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 271013925}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9c8b02fa0466d784f86ceeacb8c008f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Stressed Worker
        icon: {fileID: -1566734056, guid: 1df8bc3df1212c444ab1aa441b7c823d, type: 3}
      line: Why did they load me up with all this paperwork??
    - character:
        name: Stressed Worker
        icon: {fileID: -1566734056, guid: 1df8bc3df1212c444ab1aa441b7c823d, type: 3}
      line: I'm gonna be stuck here all day, and boss is gonna be mad!!
    - character:
        name: Epic Name Here
        icon: {fileID: 1590803138, guid: 3932dd27a1b0ccc4f8cdd01eb1cd35c1, type: 3}
      line: Uh, excuse me...?
    - character:
        name: Stressed Worker
        icon: {fileID: -1566734056, guid: 1df8bc3df1212c444ab1aa441b7c823d, type: 3}
      line: Oh goodness, I didn't see you there! Welcome to MidaCorp (tm)!
    - character:
        name: Stressed Worker
        icon: {fileID: -1566734056, guid: 1df8bc3df1212c444ab1aa441b7c823d, type: 3}
      line: Sorry about that! It's super busy, along with interviews, staff's been
        busy with some kinda new crystal stuff they found!
    - character:
        name: Stressed Worker
        icon: {fileID: -1566734056, guid: 1df8bc3df1212c444ab1aa441b7c823d, type: 3}
      line: Real cool, but I'm stuck with all the paperwork! It sucks!!
    - character:
        name: Stressed Worker
        icon: {fileID: -1566734056, guid: 1df8bc3df1212c444ab1aa441b7c823d, type: 3}
      line: Oh right, but back to you! You're here for the interview, right? Just
        take the elevator on the right and you're good to go!
  forceDialogue: 1
  repeat: 0
  ButtonPresses: 0
  DialogueLines: 7
  _swapCams: {fileID: 0}
  _cameraSwapper: 0
  _activateOnDeath: 0
  _activatedObject: {fileID: 0}
