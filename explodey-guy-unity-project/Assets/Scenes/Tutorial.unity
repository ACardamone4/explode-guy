--- !u!114 &754219746
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 754219741}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9c8b02fa0466d784f86ceeacb8c008f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Brooding Interviewee
        icon: {fileID: 1590803138, guid: 3932dd27a1b0ccc4f8cdd01eb1cd35c1, type: 3}
      line: Huh? Oh, me?
    - character:
        name: Brooding Interviewee
        icon: {fileID: 1590803138, guid: 3932dd27a1b0ccc4f8cdd01eb1cd35c1, type: 3}
      line: You want to know my story?
    - character:
        name: Epic Name Here
        icon: {fileID: 1590803138, guid: 3932dd27a1b0ccc4f8cdd01eb1cd35c1, type: 3}
      line: Uh, sure?
    - character:
        name: Brooding Interviewee
        icon: {fileID: 1590803138, guid: 3932dd27a1b0ccc4f8cdd01eb1cd35c1, type: 3}
      line: I must warn you, it is a dark and gruesome tale.
    - character:
        name: Brooding Interviewee
        icon: {fileID: 1590803138, guid: 3932dd27a1b0ccc4f8cdd01eb1cd35c1, type: 3}
      line: You see...
    - character:
        name: Brooding Interviewee
        icon: {fileID: 1590803138, guid: 3932dd27a1b0ccc4f8cdd01eb1cd35c1, type: 3}
      line: ...My electricity ran out. Apparently, you need to "pay for house functionality".
    - character:
        name: Brooding Interviewee
        icon: {fileID: 1590803138, guid: 3932dd27a1b0ccc4f8cdd01eb1cd35c1, type: 3}
      line: Horrible...
  forceDialogue: 0
  repeat: 1
  ButtonPresses: 0
  DialogueLines: 0
  _swapCams: {fileID: 0}
  _cameraSwapper: 0
  _activateOnDeath: 0
  _activatedObject: {fileID: 0}
