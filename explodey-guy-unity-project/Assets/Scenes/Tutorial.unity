--- !u!114 &1238094746
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1238094740}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9c8b02fa0466d784f86ceeacb8c008f6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
    dialogueLines:
    - character:
        name: Interviewer Again
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: Nice, you made it down.
    - character:
        name: Epic Name Here
        icon: {fileID: 277585542, guid: 98939d8069f48a849a9dc1de9596614c, type: 3}
      line: Wait, how did you...?
    - character:
        name: Interviewer Again
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: Don't worry about it.
    - character:
        name: Interviewer Again
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: Anyways, you should be good to go, just agree to this NDA real quick.
    - character:
        name: Interviewer Again
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: 'MidaCorp tm is an official business under the MegaCorpo tm Brand, and
        as such has the liability features as other locations under MegaCorpo tm.
        This includes multiple tasks for the signer of this document, including:
        Arriving to shift hours on time, Living in MegaCorpo tm facilities, and servicing
        any and all tasks assigned to this worker. Any and all harm that may come
        onto this worker will not be covered by MegaCorpo, and instead any hospital
        bills will be taken in a biweekly split with their checks.'
    - character:
        name: Epic Name Here
        icon: {fileID: 277585542, guid: 98939d8069f48a849a9dc1de9596614c, type: 3}
      line: Uhhhh... sure?
    - character:
        name: Interviewer Again
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: Cool, head on in, I'll lock the door behind you.
    - character:
        name: Interviewer Again
        icon: {fileID: 21300000, guid: 45d49575c0f0dc54e952e78524441721, type: 3}
      line: Good luck!
  forceDialogue: 1
  repeat: 0
  ButtonPresses: 0
  DialogueLines: 8
  _swapCams: {fileID: 1238094745}
  _cameraSwapper: 1
  _activateOnDeath: 0
  _activatedObject: {fileID: 0}
